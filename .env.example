# Copy to .env (never committed) and fill in.
ANTHROPIC_API_KEY=
# Fallback provider. Without it the agent runs with no fallback.
OPENAI_API_KEY=
# TypeSafe Jev classifier: opt-in for re-testing only (SKYRISK_CLASSIFIER=jev, skyrisk eval-classifier). Not used by default.
JEV_API_KEY=

# Near-term alerts. ALERT_TOKEN guards POST /api/alerts/check (unset = the check is disabled);
# use a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
ALERT_TOKEN=
# Optional Slack-compatible incoming webhook; alerts are only stored when unset.
ALERT_WEBHOOK_URL=

# Optional overrides of config/agent.yaml
# SKYRISK_PRIMARY_MODEL=claude-sonnet-5
# SKYRISK_FALLBACK_MODEL=gpt-6-luna
# SKYRISK_CLASSIFIER_MODEL=claude-haiku-4-5
# SKYRISK_CLASSIFIER=haiku   # haiku (default, no fallback) | jev (opt-in: Jev first, Haiku as its fallback)
